# Copy to .env and fill in. Never commit .env.

PORT=8080

# Where uploaded images are stored (replaces Firebase Storage)
UPLOAD_DIR=./uploads

# Path to a Firebase service-account JSON key
# (Firebase console > Project settings > Service accounts > Generate new private key)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Set to true to return realistic fake AI answers (no API key needed) – handy for demos.
MOCK_AI=false

# Free tier limits (premium users are unlimited)
FREE_SCAN_QUOTA=2
FREE_PROGRESS_QUOTA=1

# Requests per user per minute on /ai routes
AI_RATE_LIMIT_PER_MIN=10
