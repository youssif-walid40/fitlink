<file path="lib/services/ocr_service.dart">
import 'package:google_mlkit_text_recognition/google_mlkit_text_recognition.dart';

class OcrCheck {
  final bool ok;
  final String? reason;
  final int keywordHits;
  const OcrCheck(this.ok, this.reason, this.keywordHits);
}

/// Step 2 of the InBody pipeline: on-device ML Kit text recognition checks the
/// photo is readable and looks like an InBody sheet BEFORE any paid API call.
class OcrService {
  static const keywords = [
    'inbody',
    'body composition',
    'skeletal muscle',
    'body fat',
    'percent body fat',
    'pbf',
    'bmi',
    'visceral',
    'total body water',
    'basal metabolic',
    'smm',
    'segmental',
    'fat free mass',
    'muscle-fat',
  ];

  Future<OcrCheck> check(String imagePath) async {
    final recognizer = TextRecognizer(script: TextRecognitionScript.latin);
    try {
      final result = await recognizer.processImage(InputImage.fromFilePath(imagePath));
      return evaluate(result.text);
    } finally {
      await recognizer.close();
    }
  }

  /// Pure function so it can be unit-tested without a device.
  static OcrCheck evaluate(String recognizedText) {
    final text = recognizedText.toLowerCase();
    if (text.replaceAll(RegExp(r'\s+'), '').length < 30) {
      return const OcrCheck(false,
          'The photo is too blurry or dark to read. Lay the sheet flat in good light and try again.', 0);
    }
    final hits = keywords.where(text.contains).length;
    if (hits < 2) {
      return OcrCheck(false,
          'This does not look like an InBody result sheet. Make sure the whole printout is in the frame.', hits);
    }
    return OcrCheck(true, null, hits);
  }
}
</file>

<file path="lib/services/storage_service.dart">
import 'dart:io';

import 'package:image_picker/image_picker.dart';

import 'api_service.dart';

/// Image picking (camera / gallery) and uploads.
///
/// Uploads go to the FitLink backend (POST /files/upload) instead of Firebase
/// Storage, so the project runs on Firebase's free Spark plan. The backend
/// applies the same access rules Storage rules would:
///   users/{uid}/avatar.jpg, users/{uid}/scans/{scanId}.jpg  – owner only
///   pts/{uid}/…  – that trainer · gyms/{gymId}/…  – gym owner · chats/{chatId}/…  – participants
class StorageService {
  StorageService(this._api);
  final ApiService _api;
  final _picker = ImagePicker();

  /// Returns a relative URL ("/files/…"); display it with AppConfig.mediaUrl().
  Future<String> uploadImage(String path, File file) async => _api.uploadImage(path, await file.readAsBytes());

  /// Opens the camera or gallery. Images are downscaled to keep uploads small.
  Future<File?> pickImage({required bool fromCamera, double maxWidth = 1600}) async {
    final x = await _picker.pickImage(
      source: fromCamera ? ImageSource.camera : ImageSource.gallery,
      maxWidth: maxWidth,
      imageQuality: 85,
    );
    return x == null ? null : File(x.path);
  }

  static String uniqueName() => '${DateTime.now().millisecondsSinceEpoch}.jpg';
}
