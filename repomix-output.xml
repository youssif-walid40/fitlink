import { Router } from 'express';

import { db, FieldValue, messaging } from '../lib/firebase.js';
import { HttpError, route } from '../lib/http.js';

const router = Router();

/**
 * Sends a push to every device of a user and prunes dead tokens.
 * data.route tells the app which screen to open when tapped.
 */
export async function sendToUser(uid, { title, body, data = {} }) {
  const snap = await db.doc(`users/${uid}`).get();
  const tokens = (snap.data()?.fcmTokens || []).filter(Boolean);
  if (!tokens.length) return { sent: 0 };

  const stringData = Object.fromEntries(Object.entries({ ...data, title, body }).map(([k, v]) => [k, String(v ?? '')]));
  const result = await messaging.sendEachForMulticast({
    tokens,
    notification: { title, body },
    data: stringData,
    android: { priority: 'high', notification: { sound: 'default' } },
    apns: { payload: { aps: { sound: 'default' } } },
  });

  const dead = result.responses
    .map((r, i) => (!r.success && /registration-token-not-registered|invalid-registration-token|invalid-argument/.test(r.error?.code || '') ? tokens[i] : null))
    .filter(Boolean);
  if (dead.length) await db.doc(`users/${uid}`).update({ fcmTokens: FieldValue.arrayRemove(...dead) });
  return { sent: result.successCount };
}

export function coachingMessage(c, actorUid) {
  const title = c.proposal?.title || 'your plan';
  const byPt = actorUid === c.ptId;
  switch (c.status) {
    case 'requested':
      return { title: 'New coaching request', body: `${c.memberName} wants to train with you.` };
    case 'accepted':
      return { title: 'Request accepted', body: `${c.ptName} accepted your request. A plan proposal is coming.` };
    case 'declined':
      return { title: 'Request declined', body: `${c.ptName} can't take you on right now.` };
    case 'proposed':
      return { title: 'New plan proposal', body: `${c.ptName} sent you "${title}". Review and accept or counter.` };
    case 'countered':
      return { title: 'Counter offer', body: `${c.memberName} suggested changes to "${title}".` };
    case 'active':
      return byPt
        ? { title: 'Plan is active 💪', body: `${c.ptName} accepted your changes. "${title}" starts now.` }
        : { title: 'Plan accepted 🎉', body: `${c.memberName} accepted "${title}".` };
    case 'completed':
      return { title: 'Coaching completed', body: `${c.ptName} marked your coaching as completed. Leave a review!` };
    case 'cancelled':
      return { title: 'Request cancelled', body: `${c.memberName} cancelled the coaching request.` };
    default:
      return { title: 'Coaching update', body: `Your coaching with ${byPt ? c.memberName : c.ptName} was updated.` };
  }
}

/**
 * POST /notify { type: 'coaching' | 'session' | 'chat', refId, preview? }
 * The backend decides who receives the push (the *other* participant) and
 * verifies that the caller is a participant – so nobody can spam strangers.
 */
router.post(
  '/',
  route(async (req, res) => {
    const { type, refId, preview } = req.body || {};
    if (typeof refId !== 'string' || !refId || refId.includes('/')) throw new HttpError(400, 'Invalid reference.');

    if (type === 'chat') {
      const snap = await db.doc(`chats/${refId}`).get();
      const chat = snap.data();
      if (!chat || !chat.participants?.includes(req.uid)) throw new HttpError(403, 'Not a participant.');
      const to = chat.participants.find((p) => p !== req.uid);
      const from = chat.names?.[req.uid] || req.profile.name || 'New message';
      const body = String(preview || chat.lastMessage || 'New message').slice(0, 140);
      const r = await sendToUser(to, { title: from, body, data: { type: 'chat', chatId: refId, route: `/chat/${refId}` } });
      return res.json(r);
    }

    if (type === 'coaching' || type === 'session') {
      const snap = await db.doc(`coachings/${refId}`).get();
      const c = snap.data();
      if (!c || !c.participants?.includes(req.uid)) throw new HttpError(403, 'Not a participant.');
      const to = req.uid === c.memberId ? c.ptId : c.memberId;
      const msg =
        type === 'session'
          ? {
              title: 'Session logged',
              body: `${c.memberName} completed a workout (${c.sessionsDone}/${(c.proposal?.durationWeeks || 0) * (c.proposal?.sessionsPerWeek || 0)}).`,
            }
          : coachingMessage(c, req.uid);
      const r = await sendToUser(to, { ...msg, data: { type, coachingId: refId, route: `/coaching/${refId}` } });
      return res.json(r);
    }

    throw new HttpError(400, 'Unknown notification type.');
  }),
);

export default router;
</file>

<file path="backend/src/routes/writes.js">
import { Router } from 'express';

import { db, FieldValue, Timestamp } from '../lib/firebase.js';
import { HttpError, route } from '../lib/http.js';
import { sendToUser } from './notify.js';

/**
 * Sensitive writes the app is not allowed to make directly (locked by
 * firestore.rules): premium upgrades, sponsored placement and verified reviews.
 */
const router = Router();

const PLANS = { monthly: { days: 30, price: 99 }, yearly: { days: 365, price: 899 } };
const SPONSOR = { 7: 500, 30: 1500 };
const addDays = (d, n) => new Date(d.getTime() + n * 24 * 60 * 60 * 1000);

// POST /premium/activate { plan }
router.post(
  '/premium/activate',
  route(async (req, res) => {
    const plan = PLANS[req.body?.plan];
    if (!plan) throw new HttpError(400, 'Unknown plan.');
    const ref = db.doc(`users/${req.uid}`);
    const premiumUntil = await db.runTransaction(async (tx) => {
      const u = (await tx.get(ref)).data();
      const current = u?.premiumUntil?.toDate?.();
      const start = current && current > new Date() ? current : new Date();
      const until = addDays(start, plan.days);
      tx.update(ref, { isPremium: true, premiumUntil: Timestamp.fromDate(until), premiumPlan: req.body.plan });
      tx.set(db.collection('payments').doc(), {
        uid: req.uid,
        kind: 'premium',
        plan: req.body.plan,
        amountEgp: plan.price,
        simulated: true,
        createdAt: FieldValue.serverTimestamp(),
      });
      return until;
    });
    res.json({ ok: true, premiumUntil: premiumUntil.toISOString() });
  }),
);

// POST /gyms/sponsor { gymId, days }
router.post(
  '/gyms/sponsor',
  route(async (req, res) => {
    const { gymId, days } = req.body || {};
    const price = SPONSOR[days];
    if (!price || typeof gymId !== 'string' || gymId.includes('/')) throw new HttpError(400, 'Invalid sponsorship request.');
    const ref = db.doc(`gyms/${gymId}`);
    const until = await db.runTransaction(async (tx) => {
      const g = (await tx.get(ref)).data();
      if (!g) throw new HttpError(404, 'Gym not found.');
      if (g.ownerId !== req.uid) throw new HttpError(403, 'Only the gym owner can sponsor this listing.');
      if (!g.verified) throw new HttpError(409, 'Your gym must be verified before it can be sponsored.');
      const current = g.sponsoredUntil?.toDate?.();
      const start = current && current > new Date() ? current : new Date();
      const end = addDays(start, days);
      tx.update(ref, { sponsored: true, sponsoredUntil: Timestamp.fromDate(end) });
      tx.set(db.collection('payments').doc(), {
        uid: req.uid,
        kind: 'sponsor',
        gymId,
        days,
        amountEgp: price,
        simulated: true,
        createdAt: FieldValue.serverTimestamp(),
      });
      return end;
    });
    res.json({ ok: true, sponsoredUntil: until.toISOString() });
  }),
);

// POST /reviews { coachingId, rating, comment }
router.post(
  '/reviews',
  route(async (req, res) => {
    const { coachingId, rating, comment } = req.body || {};
    if (typeof coachingId !== 'string' || coachingId.includes('/')) throw new HttpError(400, 'Invalid coaching.');
    if (!Number.isInteger(rating) || rating < 1 || rating > 5) throw new HttpError(400, 'Rating must be 1–5.');
    if (typeof comment !== 'string' || comment.trim().length < 10 || comment.length > 600) {
      throw new HttpError(400, 'Comment must be 10–600 characters.');
    }

    const cRef = db.doc(`coachings/${coachingId}`);
    const ptId = await db.runTransaction(async (tx) => {
      const c = (await tx.get(cRef)).data();
      if (!c) throw new HttpError(404, 'Coaching not found.');
      if (c.memberId !== req.uid) throw new HttpError(403, 'Only the client can review this coaching.');
      if (c.status !== 'completed') throw new HttpError(409, 'You can review only after the coaching is completed.');
      if (c.reviewed) throw new HttpError(409, 'You already reviewed this coaching.');

      const ptRef = db.doc(`pts/${c.ptId}`);
      const pt = (await tx.get(ptRef)).data() || {};
      const count = pt.reviewCount || 0;
      const avg = pt.rating || 0;
      const newCount = count + 1;
      const newAvg = Math.round(((avg * count + rating) / newCount) * 100) / 100;

      tx.set(ptRef.collection('reviews').doc(coachingId), {
        memberId: req.uid,
        memberName: c.memberName,
        rating,
        comment: comment.trim(),
        coachingId,
        verified: true,
        createdAt: FieldValue.serverTimestamp(),
      });
      tx.update(ptRef, { rating: newAvg, reviewCount: newCount });
      tx.update(cRef, {
        reviewed: true,
        updatedAt: FieldValue.serverTimestamp(),
        events: FieldValue.arrayUnion({ status: 'reviewed', by: req.uid, note: `${rating}★`, at: Timestamp.now() }),
      });
      return c.ptId;
    });

    sendToUser(ptId, {
      title: 'New review ⭐',
      body: `${req.profile.name} rated you ${rating}/5.`,
      data: { type: 'review', route: `/trainers/${ptId}` },
    }).catch((e) => console.warn('review push failed', e.message));
    res.json({ ok: true });
  }),
);

export default router;
</file>

<file path="backend/src/index.js">
import 'dotenv/config';

import cors from 'cors';
import express from 'express';
import rateLimit from 'express-rate-limit';

import { errorHandler } from './lib/http.js';
import { mockMode } from './lib/llm.js';
import { requireAuth } from './middleware/auth.js';
import aiRoutes from './routes/ai.js';
import fileRoutes, { UPLOAD_DIR } from './routes/files.js';
import notifyRoutes from './routes/notify.js';
import writeRoutes from './routes/writes.js';

const app = express();
app.disable('x-powered-by');
app.use(cors());
app.use(express.json({ limit: '12mb' }));

app.get('/health', (_req, res) => res.json({ ok: true, mockAI: mockMode() }));

// Uploaded images (public but unguessable URLs, like Firebase download URLs).
const serveFiles = express.static(UPLOAD_DIR, { maxAge: '7d', fallthrough: false, dotfiles: 'deny' });
app.use('/files', (req, res, next) => (req.method === 'GET' || req.method === 'HEAD' ? serveFiles(req, res, next) : next()));

// Everything below needs a verified Firebase ID token.
app.use(requireAuth);

const perUser = (max) =>
  rateLimit({
    windowMs: 60_000,
    max,
    keyGenerator: (req) => req.uid,
    standardHeaders: true,
    legacyHeaders: false,
    message: { error: 'Too many requests. Please wait a minute and try again.' },
  });

app.use('/ai', perUser(Number(process.env.AI_RATE_LIMIT_PER_MIN || 10)), aiRoutes);
app.use('/notify', perUser(60), notifyRoutes);
app.use('/files', perUser(30), fileRoutes);
app.use('/', perUser(20), writeRoutes);

app.use((_req, res) => res.status(404).json({ error: 'Not found' }));
app.use(errorHandler);

const port = Number(process.env.PORT || 8080);
app.listen(port, () => {
  console.log(`FitLink backend listening on http://localhost:${port} (mock AI: ${mockMode()})`);
});
</file>

