<file path="tool/setup_platforms.dart">
// Patches the android/ and ios/ folders generated by `flutter create .`
// with the permissions and settings FitLink needs.
//
//   flutter create . --org com.fitlink --platforms android,ios
//   dart run tool/setup_platforms.dart
//
// Safe to run more than once.
// ignore_for_file: avoid_print
import 'dart:io';

void main() {
  _android();
  _ios();
  print('\nDone. Next: flutterfire configure  (see README.md)');
}

void _android() {
  final manifest = File('android/app/src/main/AndroidManifest.xml');
  if (!manifest.existsSync()) {
    print('! android/ not found – run `flutter create . --platforms android,ios` first.');
    return;
  }
  var xml = manifest.readAsStringSync();
  const perms = [
    'android.permission.INTERNET',
    'android.permission.CAMERA',
    'android.permission.ACCESS_FINE_LOCATION',
    'android.permission.ACCESS_COARSE_LOCATION',
    'android.permission.POST_NOTIFICATIONS',
  ];
  final missing = perms.where((p) => !xml.contains('"$p"')).toList();
  if (missing.isNotEmpty) {
    final lines = missing.map((p) => '    <uses-permission android:name="$p"/>').join('\n');
    xml = xml.replaceFirst('<application', '$lines\n    <application');
  }
  // Allows http://10.0.2.2 (local backend) during development. Use HTTPS in production.
  if (!xml.contains('usesCleartextTraffic')) {
    xml = xml.replaceFirst('<application', '<application\n        android:usesCleartextTraffic="true"');
  }
  manifest.writeAsStringSync(xml);
  print('✓ AndroidManifest.xml: permissions + cleartext (dev)');

  // Firebase Auth + ML Kit need minSdk 23.
  for (final path in ['android/app/build.gradle.kts', 'android/app/build.gradle']) {
    final f = File(path);
    if (!f.existsSync()) continue;
    var g = f.readAsStringSync();
    g = g.replaceAll(RegExp(r'minSdk\s*=\s*flutter\.minSdkVersion'), 'minSdk = 23');
    g = g.replaceAll(RegExp(r'minSdkVersion\s+flutter\.minSdkVersion'), 'minSdkVersion 23');
    f.writeAsStringSync(g);
    print('✓ $path: minSdk 23');
  }
}

void _ios() {
  final plist = File('ios/Runner/Info.plist');
  if (!plist.existsSync()) {
    print('- ios/ not found – skipping iOS setup.');
    return;
  }
  var xml = plist.readAsStringSync();
  const keys = {
    'NSCameraUsageDescription': 'FitLink uses the camera to photograph your InBody sheet and profile pictures.',
    'NSPhotoLibraryUsageDescription': 'FitLink lets you pick InBody sheets and photos from your library.',
    'NSLocationWhenInUseUsageDescription': 'FitLink uses your location to show gyms near you.',
  };
  final buf = StringBuffer();
  keys.forEach((k, v) {
    if (!xml.contains('<key>$k</key>')) buf.write('\t<key>$k</key>\n\t<string>$v</string>\n');
  });
  if (!xml.contains('<key>UIBackgroundModes</key>')) {
    buf.write('\t<key>UIBackgroundModes</key>\n\t<array>\n\t\t<string>remote-notification</string>\n\t</array>\n');
  }
  if (buf.isNotEmpty) {
    final i = xml.lastIndexOf('</dict>');
    xml = xml.replaceRange(i, i, buf.toString());
    plist.writeAsStringSync(xml);
  }
  print('✓ Info.plist: camera, photos, location, remote notifications');

  final podfile = File('ios/Podfile');
  if (podfile.existsSync()) {
    var p = podfile.readAsStringSync();
    p = p.replaceFirst(RegExp(r"#?\s*platform :ios, '[\d.]+'"), "platform :ios, '15.5'");
    podfile.writeAsStringSync(p);
    print("✓ Podfile: platform :ios, '15.5'");
  } else {
    print("- After the first iOS build, set `platform :ios, '15.5'` in ios/Podfile.");
  }
}
