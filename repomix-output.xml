<file path="lib/screens/gyms/gym_detail_screen.dart">
import 'package:flutter/material.dart';
import 'package:flutter_map/flutter_map.dart';
import 'package:go_router/go_router.dart';
import 'package:latlong2/latlong.dart';
import 'package:provider/provider.dart';

import '../../core/live_data.dart';
import '../../core/theme.dart';
import '../../core/widgets/common.dart';
import '../../models/app_user.dart';
import '../../models/gym.dart';
import '../../models/pt_profile.dart';
import '../../providers/gym_filter_provider.dart';
import '../../providers/session_provider.dart';
import '../../repositories/admin_repository.dart';
import '../../repositories/gym_repository.dart';
import '../../repositories/pt_repository.dart';
import '../../repositories/user_repository.dart';
import '../trainers/trainers_screen.dart';

class GymDetailScreen extends StatelessWidget {
  const GymDetailScreen({super.key, required this.gymId});
  final String gymId;

  @override
  Widget build(BuildContext context) {
    return StreamProvider<LiveData<Gym?>>(
      initialData: const LiveData.loading(),
      create: (c) => c.read<GymRepository>().watchGym(gymId).asLive(),
      child: Consumer<LiveData<Gym?>>(builder: (context, live, _) {
        if (live.error != null) {
          return Scaffold(appBar: AppBar(), body: ErrorView(error: live.error));
        }
        if (live.loading) return Scaffold(appBar: AppBar(), body: const LoadingView());
        final gym = live.data;
        if (gym == null) {
          return Scaffold(
            appBar: AppBar(),
            body: const EmptyView(icon: Icons.storefront_outlined, title: 'Gym not found'),
          );
        }
        return _GymDetail(gym: gym);
      }),
    );
  }
}

class _GymDetail extends StatelessWidget {
  const _GymDetail({required this.gym});
  final Gym gym;

  @override
  Widget build(BuildContext context) {
    final user = context.watch<SessionProvider>().user!;
    final km = context.read<GymFilterProvider>().distanceTo(gym);
    final muted = Theme.of(context).colorScheme.onSurfaceVariant;
    final isMyGym = user.gymId == gym.id;
    final isOwner = user.uid == gym.ownerId;

    return Scaffold(
      body: CustomScrollView(slivers: [
        SliverAppBar(
          pinned: true,
          expandedHeight: 240,
          leading: IconButton(icon: const Icon(Icons.arrow_back), onPressed: () => goBack(context)),
          actions: [
            if (isOwner)
              IconButton(icon: const Icon(Icons.edit_outlined), onPressed: () => context.push('/owner/gym')),
            if (!isOwner)
              PopupMenuButton<String>(
                onSelected: (_) => _report(context, user),
                itemBuilder: (_) => const [PopupMenuItem(value: 'report', child: Text('Report listing'))],
              ),
          ],
          flexibleSpace: FlexibleSpaceBar(
            background: gym.photos.isEmpty
                ? const NetImage(radius: 0, icon: Icons.storefront_outlined)
                : PageView(children: [for (final p in gym.photos) NetImage(url: p, radius: 0)]),
          ),
        ),
        SliverPadding(
          padding: const EdgeInsets.fromLTRB(20, 16, 20, 32),
          sliver: SliverList.list(children: [
            Wrap(spacing: 6, runSpacing: 6, children: [
              if (gym.isSponsoredNow) const Tag('SPONSORED'),
              if (gym.verified) const Tag('VERIFIED', icon: Icons.verified, color: AppColors.limeSoft, textColor: AppColors.ink),
              if (isMyGym) const Tag('YOUR GYM', color: AppColors.ink, textColor: AppColors.lime),
            ]),
            const SizedBox(height: 8),
            Text(gym.name, style: Theme.of(context).textTheme.headlineSmall?.copyWith(fontWeight: FontWeight.w800)),
            const SizedBox(height: 4),
            Text(
              [gym.area, '${km.toStringAsFixed(1)} km away', if (gym.openHours.isNotEmpty) gym.openHours].join(' · '),
              style: TextStyle(color: muted),
            ),
            if (gym.description.isNotEmpty) ...[
              const SectionHeader('About'),
              Text(gym.description, style: const TextStyle(height: 1.45)),
            ],
            const SectionHeader('Membership tiers'),
            if (gym.tiers.isEmpty) Text('No tiers listed yet.', style: TextStyle(color: muted)),
            for (final t in gym.tiers) ...[
              _TierCard(
                tier: t,
                current: isMyGym && user.gymTier == t.name,
                onJoin: user.isMember ? () => _join(context, user, t) : null,
              ),
              const SizedBox(height: 10),
            ],
            if (gym.facilities.isNotEmpty) ...[
              const SectionHeader('Facilities'),
              Wrap(spacing: 8, runSpacing: 8, children: [
                for (final f in gym.facilities) Chip(label: Text(f), avatar: const Icon(Icons.check, size: 16)),
              ]),
            ],
            if (gym.policies.isNotEmpty) ...[
              const SectionHeader('Policies'),
              for (final p in gym.policies)
                Padding(
                  padding: const EdgeInsets.only(bottom: 6),
                  child: Row(crossAxisAlignment: CrossAxisAlignment.start, children: [
                    const Padding(padding: EdgeInsets.only(top: 7), child: Icon(Icons.circle, size: 6)),
                    const SizedBox(width: 10),
                    Expanded(child: Text(p)),
                  ]),
                ),
            ],
            const SectionHeader('Location'),
            if (gym.address.isNotEmpty) Text(gym.address, style: TextStyle(color: muted)),
            const SizedBox(height: 8),
            ClipRRect(
              borderRadius: BorderRadius.circular(14),
              child: SizedBox(
                height: 170,
                child: FlutterMap(
                  options: MapOptions(
                    initialCenter: LatLng(gym.lat, gym.lng),
                    initialZoom: 15,
                    interactionOptions: const InteractionOptions(flags: InteractiveFlag.none),
                  ),
                  children: [
                    TileLayer(
                      urlTemplate: 'https://tile.openstreetmap.org/{z}/{x}/{y}.png',
                      userAgentPackageName: 'com.fitlink.app',
                    ),
                    MarkerLayer(markers: [
                      Marker(
                        point: LatLng(gym.lat, gym.lng),
                        width: 40,
                        height: 40,
                        child: const Icon(Icons.location_on, size: 36, color: AppColors.ink),
                      ),
                    ]),
                  ],
                ),
              ),
            ),
            _GymTrainers(gym: gym),
            if (user.isPt) _AffiliationAction(gym: gym, user: user),
            if (isMyGym && user.isMember) ...[
              const SizedBox(height: 20),
              OutlinedButton(
                onPressed: () async {
                  if (await confirm(context, title: 'Leave gym?', message: 'You will be removed from ${gym.name}.', danger: true, ok: 'Leave')) {
                    if (context.mounted) await context.read<UserRepository>().leaveGym(user);
                  }
                },
                child: const Text('Leave this gym'),
              ),
            ],
          ]),
        ),
      ]),
    );
  }

  Future<void> _join(BuildContext context, AppUser user, GymTier tier) async {
    final ok = await confirm(
      context,
      title: 'Join ${gym.name}',
      message: '${tier.name} – ${egp(tier.price)} per ${tier.period}.\n\nPayment is simulated in this prototype.',
      ok: 'Pay & join',
    );
    if (!ok || !context.mounted) return;
    try {
      await context.read<UserRepository>().joinGym(user, gym, tier);
      if (context.mounted) showSnack(context, 'Welcome to ${gym.name}! 🎉');
    } catch (e) {
      if (context.mounted) showSnack(context, friendlyError(e), error: true);
    }
  }

  Future<void> _report(BuildContext context, AppUser user) async {
    final reason = await promptText(context, title: 'Report ${gym.name}', hint: 'What is wrong with this listing?');
    if (reason == null || !context.mounted) return;
    await context.read<AdminRepository>().submitReport(
          reporterId: user.uid,
          targetType: 'gym',
          targetId: gym.id,
          targetName: gym.name,
          reason: reason,
        );
    if (context.mounted) showSnack(context, 'Thanks – our team will review it.');
  }
}

class _TierCard extends StatelessWidget {
  const _TierCard({required this.tier, required this.current, this.onJoin});
  final GymTier tier;
  final bool current;
  final VoidCallback? onJoin;

  @override
  Widget build(BuildContext context) => AppCard(
        highlighted: current,
        child: Row(children: [
          Expanded(
            child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
              Text(tier.name, style: const TextStyle(fontWeight: FontWeight.w700, fontSize: 16)),
              Text('${egp(tier.price)} / ${tier.period}', style: const TextStyle(fontWeight: FontWeight.w600)),
              if (tier.perks.isNotEmpty) ...[
                const SizedBox(height: 4),
                Text(tier.perks.join(' · '),
                    style: TextStyle(fontSize: 13, color: Theme.of(context).colorScheme.onSurfaceVariant)),
              ],
            ]),
          ),
          if (current)
            const Tag('CURRENT', color: AppColors.lime, textColor: AppColors.ink)
          else if (onJoin != null)
            FilledButton(
              onPressed: onJoin,
              style: FilledButton.styleFrom(minimumSize: const Size(70, 40)),
              child: const Text('Join'),
            ),
        ]),
      );
}

class _GymTrainers extends StatelessWidget {
  const _GymTrainers({required this.gym});
  final Gym gym;

  @override
  Widget build(BuildContext context) {
    final pts = context.watch<LiveData<List<PtProfile>>>().data ?? const <PtProfile>[];
    return StreamBuilder<Set<String>>(
      stream: context.read<PtRepository>().watchApprovedPtIds(gym.id),
      builder: (context, snap) {
        final ids = snap.data ?? const <String>{};
        final list = pts.where((p) => ids.contains(p.id)).toList();
        if (list.isEmpty) return const SizedBox.shrink();
        return Column(crossAxisAlignment: CrossAxisAlignment.stretch, children: [
          const SectionHeader('Trainers at this gym'),
          for (final p in list) ...[TrainerCard(pt: p), const SizedBox(height: 10)],
        ]);
      },
    );
  }
}

class _AffiliationAction extends StatelessWidget {
  const _AffiliationAction({required this.gym, required this.user});
  final Gym gym;
  final AppUser user;

  @override
  Widget build(BuildContext context) {
    final repo = context.read<PtRepository>();
    return StreamBuilder<List<Affiliation>>(
      stream: repo.watchPtAffiliations(user.uid),
      builder: (context, snap) {
        final mine = (snap.data ?? const <Affiliation>[]).where((a) => a.gymId == gym.id).firstOrNull;
        return Padding(
          padding: const EdgeInsets.only(top: 20),
          child: mine == null
              ? FilledButton.icon(
                  icon: const Icon(Icons.handshake_outlined),
                  label: const Text('Request to coach at this gym'),
                  onPressed: () async {
                    try {
                      await repo.requestAffiliation(ptId: user.uid, ptName: user.name, gym: gym);
                      if (context.mounted) showSnack(context, 'Request sent to the gym owner');
                    } catch (e) {
                      if (context.mounted) showSnack(context, friendlyError(e), error: true);
                    }
                  },
                )
              : AppCard(
                  child: Row(children: [
                    Icon(mine.status == 'approved' ? Icons.verified : Icons.hourglass_top),
                    const SizedBox(width: 12),
                    Expanded(
                      child: Text(switch (mine.status) {
                        'approved' => 'You are listed as a trainer at this gym.',
                        'rejected' => 'The gym declined your affiliation request.',
                        _ => 'Affiliation request pending owner approval.',
                      }),
                    ),
                  ]),
                ),
        );
      },
    );
  }
}

/// Small dialog that asks for one line of text.
Future<String?> promptText(BuildContext context, {required String title, String? hint, String ok = 'Send'}) {
  final ctrl = TextEditingController();
  return showDialog<String>(
    context: context,
    builder: (c) => AlertDialog(
      title: Text(title),
      content: TextField(
        controller: ctrl,
        autofocus: true,
        maxLines: 3,
        maxLength: 300,
        decoration: InputDecoration(hintText: hint),
      ),
      actions: [
        TextButton(onPressed: () => Navigator.pop(c), child: const Text('Cancel')),
        FilledButton(
          onPressed: () {
            if (ctrl.text.trim().length >= 3) Navigator.pop(c, ctrl.text.trim());
          },
          child: Text(ok),
        ),
      ],
    ),
  );
}
</file>

<file path="lib/screens/gyms/gyms_screen.dart">
import 'package:flutter/material.dart';
import 'package:flutter_map/flutter_map.dart';
import 'package:go_router/go_router.dart';
import 'package:latlong2/latlong.dart';
import 'package:provider/provider.dart';

import '../../core/constants.dart';
import '../../core/live_data.dart';
import '../../core/theme.dart';
import '../../core/widgets/common.dart';
import '../../models/gym.dart';
import '../../providers/gym_filter_provider.dart';

class GymsScreen extends StatefulWidget {
  const GymsScreen({super.key});

  @override
  State<GymsScreen> createState() => _GymsScreenState();
}

class _GymsScreenState extends State<GymsScreen> {
  final _search = TextEditingController();

  @override
  void initState() {
    super.initState();
    WidgetsBinding.instance.addPostFrameCallback((_) {
      final f = context.read<GymFilterProvider>();
      _search.text = f.query;
      if (!f.position.live) f.locate();
    });
  }

  @override
  void dispose() {
    _search.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    final live = context.watch<LiveData<List<Gym>>>();
    final filter = context.watch<GymFilterProvider>();

    return Scaffold(
      appBar: AppBar(
        toolbarHeight: 70,
        title: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
          const Text('Nearby gyms'),
          Text(
            filter.locating
                ? 'Finding your location…'
                : filter.sort == GymSort.price
                    ? 'Sorted by price'
                    : 'Sorted by distance',
            style: TextStyle(fontSize: 12, fontWeight: FontWeight.w400, color: Theme.of(context).colorScheme.onSurfaceVariant),
          ),
        ]),
        actions: [
          IconButton(
            tooltip: 'Use my location',
            onPressed: filter.locating ? null : filter.locate,
            icon: filter.locating
                ? const SizedBox(width: 18, height: 18, child: CircularProgressIndicator(strokeWidth: 2))
                : Icon(filter.position.live ? Icons.my_location : Icons.location_searching),
          ),
          const ProfileAction(),
        ],
      ),
      body: Column(children: [
        Padding(
          padding: const EdgeInsets.fromLTRB(16, 4, 16, 8),
          child: Row(children: [
            Expanded(
              child: TextField(
                controller: _search,
                onChanged: filter.setQuery,
                textInputAction: TextInputAction.search,
                decoration: InputDecoration(
                  hintText: 'Search gyms or areas',
                  prefixIcon: const Icon(Icons.search),
                  suffixIcon: filter.query.isEmpty
                      ? null
                      : IconButton(
                          icon: const Icon(Icons.close),
                          onPressed: () {
                            _search.clear();
                            filter.setQuery('');
                          },
                        ),
                ),
              ),
            ),
            const SizedBox(width: 8),
            _ToggleButton(label: 'Map', selected: filter.showMap, onTap: () => filter.toggleMap(true)),
            const SizedBox(width: 6),
            _ToggleButton(label: 'List', selected: !filter.showMap, onTap: () => filter.toggleMap(false)),
          ]),
        ),
        SizedBox(
          height: 40,
          child: ListView(
            scrollDirection: Axis.horizontal,
            padding: const EdgeInsets.symmetric(horizontal: 16),
            children: [
              ActionChip(
                avatar: Icon(Icons.tune, size: 18, color: filter.hasFilters ? AppColors.ink : null),
                label: Text(filter.hasFilters ? 'Filters on' : 'Filters'),
                backgroundColor: filter.hasFilters ? AppColors.lime : null,
                labelStyle: filter.hasFilters ? const TextStyle(color: AppColors.ink) : null,
                onPressed: () => _openFilters(context),
              ),
              const SizedBox(width: 8),
              ChoiceChip(
                label: const Text('Nearest'),
                selected: filter.sort == GymSort.distance,
                onSelected: (_) => filter.setSort(GymSort.distance),
              ),
              const SizedBox(width: 8),
              ChoiceChip(
                label: const Text('Cheapest'),
                selected: filter.sort == GymSort.price,
                onSelected: (_) => filter.setSort(GymSort.price),
              ),
              for (final f in ['Women-only hours', 'Pool', 'Open 24/7']) ...[
                const SizedBox(width: 8),
                FilterChip(label: Text(f), selected: filter.facilities.contains(f), onSelected: (_) => filter.toggleFacility(f)),
              ],
            ],
          ),
        ),
        if (filter.locationNote != null)
          Padding(
            padding: const EdgeInsets.fromLTRB(16, 6, 16, 0),
            child: Row(children: [
              const Icon(Icons.info_outline, size: 14),
              const SizedBox(width: 6),
              Expanded(child: Text(filter.locationNote!, style: const TextStyle(fontSize: 12))),
            ]),
          ),
        const SizedBox(height: 8),
        Expanded(
          child: LiveView<List<Gym>>(
            live: live,
            onRetry: () => setState(() {}),
            builder: (gyms) {
              final results = filter.apply(gyms);
              if (results.isEmpty) {
                return EmptyView(
                  icon: Icons.search_off,
                  title: gyms.isEmpty ? 'No gyms listed yet' : 'No gyms match',
                  message: gyms.isEmpty ? 'Check back soon.' : 'Try a different search or clear filters.',
                  action: filter.hasFilters
                      ? OutlinedButton(onPressed: filter.clear, child: const Text('Clear filters'))
                      : null,
                );
              }
              return AnimatedSwitcher(
                duration: const Duration(milliseconds: 250),
                child: filter.showMap
                    ? _GymMap(key: const ValueKey('map'), results: results, filter: filter)
                    : _GymList(key: const ValueKey('list'), results: results, onRefresh: filter.locate),
              );
            },
          ),
        ),
      ]),
    );
  }

  void _openFilters(BuildContext context) => showModalBottomSheet(
        context: context,
        isScrollControlled: true,
        showDragHandle: true,
        builder: (_) => ChangeNotifierProvider.value(
          value: context.read<GymFilterProvider>(),
          child: const _FilterSheet(),
        ),
      );
}

class _ToggleButton extends StatelessWidget {
  const _ToggleButton({required this.label, required this.selected, required this.onTap});
  final String label;
  final bool selected;
  final VoidCallback onTap;

  @override
  Widget build(BuildContext context) => SizedBox(
        height: 50,
        child: selected
            ? FilledButton(onPressed: onTap, style: FilledButton.styleFrom(minimumSize: const Size(60, 50)), child: Text(label))
            : OutlinedButton(onPressed: onTap, style: OutlinedButton.styleFrom(minimumSize: const Size(60, 50)), child: Text(label)),
      );
}

class _GymList extends StatelessWidget {
  const _GymList({super.key, required this.results, required this.onRefresh});
  final List<GymWithDistance> results;
  final Future<void> Function() onRefresh;

  @override
  Widget build(BuildContext context) => RefreshIndicator(
        onRefresh: onRefresh,
        child: ListView.separated(
          padding: const EdgeInsets.fromLTRB(16, 4, 16, 24),
          itemCount: results.length,
          separatorBuilder: (_, __) => const SizedBox(height: 10),
          itemBuilder: (_, i) => GymCard(gym: results[i].gym, km: results[i].km),
        ),
      );
}

class GymCard extends StatelessWidget {
  const GymCard({super.key, required this.gym, this.km});
  final Gym gym;
  final double? km;

  @override
  Widget build(BuildContext context) {
    final muted = Theme.of(context).colorScheme.onSurfaceVariant;
    final details = [
      if (km != null) '${km!.toStringAsFixed(1)} km',
      if (gym.minPrice != null) 'from ${egp(gym.minPrice!)}/mo',
    ].join(' · ');
    return AppCard(
      highlighted: gym.isSponsoredNow,
      padding: const EdgeInsets.all(12),
      onTap: () => context.push('/gyms/${gym.id}'),
      child: Row(children: [
        NetImage(url: gym.photos.isEmpty ? null : gym.photos.first, width: 64, height: 64, radius: 10),
        const SizedBox(width: 14),
        Expanded(
          child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
            if (gym.isSponsoredNow)
              Text('SPONSORED',
                  style: TextStyle(fontSize: 10, fontWeight: FontWeight.w800, letterSpacing: 1, color: muted)),
            Text(gym.name, style: const TextStyle(fontWeight: FontWeight.w700, fontSize: 16)),
            const SizedBox(height: 2),
            Text(details, style: TextStyle(color: muted, fontSize: 13)),
            if (gym.facilities.isNotEmpty)
              Text(gym.facilities.take(3).join(' · '),
                  maxLines: 1, overflow: TextOverflow.ellipsis, style: TextStyle(color: muted, fontSize: 13)),
          ]),
        ),
        const Icon(Icons.chevron_right),
      ]),
    );
  }
}

class _GymMap extends StatelessWidget {
  const _GymMap({super.key, required this.results, required this.filter});
  final List<GymWithDistance> results;
  final GymFilterProvider filter;

  @override
  Widget build(BuildContext context) {
    final me = LatLng(filter.position.lat, filter.position.lng);
    return Padding(
      padding: const EdgeInsets.fromLTRB(16, 0, 16, 16),
      child: ClipRRect(
        borderRadius: BorderRadius.circular(16),
        child: FlutterMap(
          options: MapOptions(initialCenter: me, initialZoom: 12.5),
          children: [
            TileLayer(
              urlTemplate: 'https://tile.openstreetmap.org/{z}/{x}/{y}.png',
              userAgentPackageName: 'com.fitlink.app',
            ),
            MarkerLayer(markers: [
              Marker(
                point: me,
                width: 22,
                height: 22,
                child: Container(
                  decoration: BoxDecoration(
                    color: Colors.blue,
                    shape: BoxShape.circle,
                    border: Border.all(color: Colors.white, width: 3),
                  ),
                ),
              ),
              for (final r in results)
                Marker(
                  point: LatLng(r.gym.lat, r.gym.lng),
                  width: 150,
                  height: 56,
                  alignment: Alignment.topCenter,
                  child: GestureDetector(
                    onTap: () => context.push('/gyms/${r.gym.id}'),
                    child: Column(mainAxisSize: MainAxisSize.min, children: [
                      Container(
                        padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
                        decoration: BoxDecoration(
                          color: r.gym.isSponsoredNow ? AppColors.lime : AppColors.ink,
                          borderRadius: BorderRadius.circular(8),
                        ),
                        child: Text(
                          r.gym.name,
                          maxLines: 1,
                          overflow: TextOverflow.ellipsis,
                          style: TextStyle(
                            fontSize: 11,
