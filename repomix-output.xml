              onTap: () => context.push('/scan/${user.uid}/${h.id}'),
            ),
          const Disclaimer(),
        ]),
      );
    }

    return Scaffold(
      appBar: AppBar(
        toolbarHeight: 70,
        title: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
          const Text('InBody analysis'),
          Text('Scan read and explained by AI',
