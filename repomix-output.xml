<file path="lib/screens/profile/edit_profile_screen.dart">
import 'dart:io';

import 'package:flutter/material.dart';
import 'package:provider/provider.dart';

import '../../core/constants.dart';
import '../../core/live_data.dart';
import '../../core/validators.dart';
import '../../core/widgets/common.dart';
import '../../providers/session_provider.dart';
import '../../repositories/user_repository.dart';
import '../../services/storage_service.dart';

class EditProfileScreen extends StatefulWidget {
  const EditProfileScreen({super.key});

  @override
  State<EditProfileScreen> createState() => _EditProfileScreenState();
}

class _EditProfileScreenState extends State<EditProfileScreen> {
  final _form = GlobalKey<FormState>();
  late final _user = context.read<SessionProvider>().user!;
  late final _name = TextEditingController(text: _user.name);
  late final _phone = TextEditingController(text: _user.phone ?? '');
  late String _goal = _user.goal;
  File? _photo;
  bool _busy = false;

  @override
  void dispose() {
    _name.dispose();
    _phone.dispose();
    super.dispose();
  }

  Future<void> _pickPhoto() async {
    final storage = context.read<StorageService>();
    final camera = await showModalBottomSheet<bool>(
      context: context,
      showDragHandle: true,
      builder: (c) => SafeArea(
        child: Column(mainAxisSize: MainAxisSize.min, children: [
          ListTile(leading: const Icon(Icons.camera_alt_outlined), title: const Text('Take photo'), onTap: () => Navigator.pop(c, true)),
          ListTile(leading: const Icon(Icons.photo_library_outlined), title: const Text('Choose from gallery'), onTap: () => Navigator.pop(c, false)),
        ]),
      ),
    );
    if (camera == null) return;
    final f = await storage.pickImage(fromCamera: camera, maxWidth: 800);
    if (f != null && mounted) setState(() => _photo = f);
  }

  Future<void> _save() async {
    if (!_form.currentState!.validate()) return;
    final users = context.read<UserRepository>();
    final storage = context.read<StorageService>();
    setState(() => _busy = true);
    try {
      String? url;
      if (_photo != null) url = await storage.uploadImage('users/${_user.uid}/avatar.jpg', _photo!);
      await users.updateProfile(_user.uid, name: _name.text, phone: _phone.text, goal: _goal, photoUrl: url);
      if (_user.isPt) await users.syncPtIdentity(_user.uid, name: _name.text, photoUrl: url);
      if (!mounted) return;
      showSnack(context, 'Profile updated');
      goBack(context);
    } catch (e) {
      if (mounted) showSnack(context, friendlyError(e), error: true);
    } finally {
      if (mounted) setState(() => _busy = false);
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: const Text('Edit profile')),
      body: Form(
        key: _form,
        child: ListView(padding: const EdgeInsets.all(20), children: [
          Center(
            child: GestureDetector(
              onTap: _pickPhoto,
              child: Stack(children: [
                _photo != null
                    ? CircleAvatar(radius: 52, backgroundImage: FileImage(_photo!))
                    : UserAvatar(initials: _user.initials, url: _user.photoUrl, radius: 52),
                Positioned(
                  right: 0,
                  bottom: 0,
                  child: CircleAvatar(
                    radius: 18,
                    backgroundColor: Theme.of(context).colorScheme.primary,
                    child: Icon(Icons.camera_alt, size: 18, color: Theme.of(context).colorScheme.onPrimary),
                  ),
                ),
              ]),
            ),
          ),
          const SizedBox(height: 24),
          TextFormField(
            controller: _name,
            textCapitalization: TextCapitalization.words,
            decoration: const InputDecoration(labelText: 'Full name'),
            validator: Validators.name,
          ),
          const SizedBox(height: 14),
          TextFormField(
            controller: _phone,
            keyboardType: TextInputType.phone,
            decoration: const InputDecoration(labelText: 'Phone (optional)', hintText: '+201xxxxxxxxx'),
            validator: Validators.phone,
          ),
          if (_user.isMember) ...[
            const SizedBox(height: 14),
            DropdownButtonFormField<String>(
              initialValue: _goal,
              decoration: const InputDecoration(labelText: 'Fitness goal'),
              items: [for (final e in AppConfig.goals.entries) DropdownMenuItem(value: e.key, child: Text(e.value))],
              onChanged: (v) => setState(() => _goal = v ?? _goal),
            ),
          ],
          const SizedBox(height: 24),
          BusyButton(label: 'Save changes', busy: _busy, onPressed: _save),
        ]),
      ),
    );
  }
}
</file>

<file path="lib/screens/profile/premium_screen.dart">
import 'package:flutter/material.dart';
import 'package:provider/provider.dart';

import '../../core/constants.dart';
import '../../core/live_data.dart';
import '../../core/theme.dart';
import '../../core/widgets/common.dart';
import '../../providers/session_provider.dart';
import '../../services/api_service.dart';

/// Premium subscription with simulated payment. The upgrade itself is done by
/// the backend (/premium/activate) – the app can never set isPremium directly.
class PremiumScreen extends StatefulWidget {
  const PremiumScreen({super.key});

  @override
  State<PremiumScreen> createState() => _PremiumScreenState();
}

class _PremiumScreenState extends State<PremiumScreen> {
  String _plan = 'yearly';
  bool _busy = false;

  Future<void> _buy() async {
    final plan = AppConfig.premiumPlans[_plan]!;
    final paid = await showModalBottomSheet<bool>(
      context: context,
      isScrollControlled: true,
      showDragHandle: true,
      builder: (_) => _FakeCheckout(label: plan.label, price: plan.price),
    );
    if (paid != true || !mounted) return;
    setState(() => _busy = true);
    try {
      await context.read<ApiService>().activatePremium(_plan);
      if (!mounted) return;
      showSnack(context, 'Welcome to FitLink Premium! 🎉');
      goBack(context);
    } catch (e) {
      if (mounted) showSnack(context, friendlyError(e), error: true);
    } finally {
      if (mounted) setState(() => _busy = false);
    }
  }

  @override
  Widget build(BuildContext context) {
    final user = context.watch<SessionProvider>().user!;
    return Scaffold(
      appBar: AppBar(title: const Text('FitLink Premium')),
      body: ListView(padding: const EdgeInsets.all(20), children: [
        const DarkCard(
          child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
            Icon(Icons.workspace_premium, color: AppColors.lime, size: 36),
            SizedBox(height: 10),
            Text('Understand every scan', style: TextStyle(color: Colors.white, fontSize: 22, fontWeight: FontWeight.w800)),
            SizedBox(height: 6),
            Text('Free accounts include 2 InBody analyses and 1 progress report.',
                style: TextStyle(color: Colors.white70)),
          ]),
        ),
        const SizedBox(height: 16),
        for (final f in const [
          'Unlimited AI InBody explanations',
          'Unlimited progress-over-time analysis',
          'History charts for every metric',
          'Share any scan with your coach',
        ])
          ListTile(contentPadding: EdgeInsets.zero, leading: const Icon(Icons.check_circle, color: AppColors.success), title: Text(f)),
        const SizedBox(height: 8),
        if (user.isPremium)
          const AppCard(child: Text('You already have Premium. Thank you for supporting FitLink!'))
        else ...[
          for (final e in AppConfig.premiumPlans.entries) ...[
            AppCard(
              highlighted: _plan == e.key,
              onTap: () => setState(() => _plan = e.key),
              child: Row(children: [
                Icon(_plan == e.key ? Icons.radio_button_checked : Icons.radio_button_off),
                const SizedBox(width: 12),
                Expanded(
                  child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
                    Text(e.value.label, style: const TextStyle(fontWeight: FontWeight.w700, fontSize: 16)),
                    if (e.key == 'yearly') const Text('Save 24% vs monthly', style: TextStyle(fontSize: 12)),
                  ]),
                ),
                Text('${egp(e.value.price)}/${e.value.period}', style: const TextStyle(fontWeight: FontWeight.w800)),
              ]),
            ),
            const SizedBox(height: 10),
          ],
          const SizedBox(height: 8),
          BusyButton(label: 'Continue', busy: _busy, onPressed: _buy),
          const SizedBox(height: 8),
          Text('Payment is simulated in this prototype. Cancel anytime.',
              textAlign: TextAlign.center, style: TextStyle(fontSize: 12, color: Theme.of(context).colorScheme.onSurfaceVariant)),
        ],
      ]),
    );
  }
}

class _FakeCheckout extends StatefulWidget {
  const _FakeCheckout({required this.label, required this.price});
  final String label;
  final int price;

  @override
  State<_FakeCheckout> createState() => _FakeCheckoutState();
}

class _FakeCheckoutState extends State<_FakeCheckout> {
  final _form = GlobalKey<FormState>();
  bool _processing = false;

  @override
  Widget build(BuildContext context) => Padding(
        padding: EdgeInsets.fromLTRB(20, 0, 20, MediaQuery.viewInsetsOf(context).bottom + 20),
        child: Form(
          key: _form,
          child: Column(mainAxisSize: MainAxisSize.min, crossAxisAlignment: CrossAxisAlignment.stretch, children: [
            Text('Pay ${egp(widget.price)}', style: const TextStyle(fontSize: 20, fontWeight: FontWeight.w800)),
            Text('${widget.label} plan · simulated checkout'),
            const SizedBox(height: 16),
            TextFormField(
              initialValue: '4242 4242 4242 4242',
              decoration: const InputDecoration(labelText: 'Card number (test)'),
              keyboardType: TextInputType.number,
              validator: (v) => (v ?? '').replaceAll(' ', '').length == 16 ? null : 'Enter 16 digits',
            ),
            const SizedBox(height: 10),
            Row(children: [
              Expanded(
                child: TextFormField(
                  initialValue: '12/30',
                  decoration: const InputDecoration(labelText: 'MM/YY'),
                  validator: (v) => RegExp(r'^\d{2}/\d{2}$').hasMatch(v ?? '') ? null : 'MM/YY',
                ),
              ),
              const SizedBox(width: 10),
              Expanded(
                child: TextFormField(
                  initialValue: '123',
                  decoration: const InputDecoration(labelText: 'CVC'),
                  validator: (v) => RegExp(r'^\d{3}$').hasMatch(v ?? '') ? null : '3 digits',
                ),
              ),
            ]),
            const SizedBox(height: 16),
            BusyButton(
              label: 'Pay now',
              busy: _processing,
              onPressed: () async {
                if (!_form.currentState!.validate()) return;
                setState(() => _processing = true);
