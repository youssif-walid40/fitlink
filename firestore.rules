rules_version = '2';

// FitLink Firestore security rules.
// Principles:
//  * Users read/write only their own profile, scans and chats.
//  * PTs see a client's scan only if the client shared it (sharedWith).
//  * role, isPremium, aiUsage, verified, sponsored, ratings and reviews are
//    changed only by the backend (Admin SDK bypasses these rules).
//  * The coaching workflow's status transitions are enforced here as well.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function profile() { return get(/databases/$(database)/documents/users/$(uid())).data; }
    function role() { return profile().role; }
    function isAdmin() { return signedIn() && role() == 'admin'; }
    function changedKeys() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // ---------------- Users (private) ----------------
    match /users/{userId} {
      allow read: if signedIn() && (uid() == userId || isAdmin());
      allow create: if signedIn() && uid() == userId
        && request.resource.data.role in ['member', 'pt', 'owner']
        && request.resource.data.isPremium == false
        && request.resource.data.aiUsage.scans == 0
        && request.resource.data.aiUsage.progress == 0
        && !('premiumUntil' in request.resource.data);
      allow update: if signedIn() && uid() == userId
        && changedKeys().hasOnly(['name', 'photoUrl', 'phone', 'goal', 'gymId', 'gymName', 'gymTier', 'fcmTokens', 'updatedAt']);
      allow delete: if false;

      // Private health data.
      match /scans/{scanId} {
        allow read: if signedIn() && (uid() == userId || uid() in resource.data.sharedWith);
        allow create: if signedIn() && uid() == userId
          && request.resource.data.memberId == userId
          && request.resource.data.sharedWith.size() == 0;
        allow update: if signedIn() && uid() == userId && changedKeys().hasOnly(['sharedWith']);
        allow delete: if signedIn() && uid() == userId;
      }

      match /progressReports/{reportId} {
        allow read, create: if signedIn() && uid() == userId;
        allow update, delete: if false;
      }
    }

    // ---------------- Trainers (public profiles) ----------------
    match /pts/{ptId} {
      allow read: if signedIn();
      allow create: if signedIn() && uid() == ptId
        && getAfter(/databases/$(database)/documents/users/$(uid())).data.role == 'pt'
        && request.resource.data.verified == false
        && request.resource.data.rating == 0
        && request.resource.data.reviewCount == 0;
      allow update: if signedIn() && (
        (uid() == ptId && changedKeys().hasOnly(['name', 'photoUrl', 'bio', 'specialties', 'monthlyPrice', 'mode',
                                               'yearsExperience', 'transformations', 'updatedAt']))
        || (isAdmin() && changedKeys().hasOnly(['verified'])));
      allow delete: if false;

      match /reviews/{reviewId} {
        allow read: if signedIn();
        allow write: if false; // only the backend writes verified reviews
      }
    }

    // ---------------- Gyms ----------------
    match /gyms/{gymId} {
      allow read: if signedIn();
      allow create: if signedIn() && role() == 'owner'
        && request.resource.data.ownerId == uid()
        && request.resource.data.verified == false
        && request.resource.data.sponsored == false;
      allow update: if signedIn() && (
        (resource.data.ownerId == uid()
          && request.resource.data.ownerId == uid()
          && changedKeys().hasOnly(['name', 'description', 'area', 'address', 'lat', 'lng', 'tiers', 'photos',
                                    'policies', 'facilities', 'openHours', 'updatedAt']))
        || (isAdmin() && changedKeys().hasOnly(['verified'])));
      allow delete: if false;

      match /members/{memberId} {
        allow read: if signedIn()
          && (uid() == memberId || get(/databases/$(database)/documents/gyms/$(gymId)).data.ownerId == uid());
        allow create, update, delete: if signedIn() && uid() == memberId;
      }
    }

    // ---------------- PT ↔ gym affiliations ----------------
    match /affiliations/{affId} {
      allow read: if signedIn();
      allow create: if signedIn() && role() == 'pt'
        && request.resource.data.ptId == uid()
        && affId == uid() + '_' + request.resource.data.gymId
        && request.resource.data.status == 'pending'
        && get(/databases/$(database)/documents/gyms/$(request.resource.data.gymId)).data.ownerId
             == request.resource.data.ownerId;
      allow update: if signedIn() && resource.data.ownerId == uid()
        && changedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['approved', 'rejected'];
      allow delete: if signedIn() && resource.data.ptId == uid();
    }

    // ---------------- Coaching workflow ----------------
    function validTransition(from, to, d) {
      let isPt = uid() == d.ptId;
      let isMember = uid() == d.memberId;
      return (isPt && from == 'requested' && to in ['accepted', 'declined'])
        || (isPt && from in ['accepted', 'proposed', 'countered'] && to == 'proposed')
        || (isMember && from == 'proposed' && to in ['active', 'countered'])
        || (isPt && from == 'countered' && to == 'active')
        || (isPt && from == 'active' && to == 'completed')
        || (isMember && from in ['requested', 'accepted', 'proposed', 'countered'] && to == 'cancelled');
    }

    match /coachings/{coachingId} {
      allow read: if signedIn() && uid() in resource.data.participants;
      allow create: if signedIn() && role() == 'member'
        && request.resource.data.memberId == uid()
        && request.resource.data.participants == [uid(), request.resource.data.ptId]
        && request.resource.data.status == 'requested'
        && request.resource.data.reviewed == false
        && request.resource.data.sessionsDone == 0;
      allow update: if signedIn() && uid() in resource.data.participants
        && request.resource.data.memberId == resource.data.memberId
        && request.resource.data.ptId == resource.data.ptId
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.reviewed == resource.data.reviewed
        && (
          (request.resource.data.status == resource.data.status
            && changedKeys().hasOnly(['sessionsDone', 'sharedScanIds', 'updatedAt']))
          || validTransition(resource.data.status, request.resource.data.status, resource.data)
        );
      allow delete: if false;
    }

    // ---------------- Chat ----------------
    match /chats/{chatId} {
      allow read: if signedIn() && uid() in resource.data.participants;
      allow create: if signedIn()
        && uid() in request.resource.data.participants
        && request.resource.data.participants.size() == 2
        && chatId == request.resource.data.participants[0] + '_' + request.resource.data.participants[1];
      allow update: if signedIn() && uid() in resource.data.participants
        && request.resource.data.participants == resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        function chat() { return get(/databases/$(database)/documents/chats/$(chatId)).data; }
        allow read: if signedIn() && uid() in chat().participants;
        allow create: if signedIn() && request.resource.data.senderId == uid() && uid() in chat().participants;
        allow update, delete: if false;
      }
    }

    // ---------------- Moderation ----------------
    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterId == uid();
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // Simulated payment log – backend only.
    match /payments/{paymentId} {
      allow read, write: if false;
    }
  }
}
